# Notes on Type Flags:
#   ":TT"  Types are 'Transient', building block types to be discarded
#   ":TKU" Types are 'Keep', 'Unique' types are are kept for use at runtime


":TKU", "Integer16", 		"Short",	""
":TT", "MMSIdentifier", 	"Vstring64",	""
":TT", "Boolean",	 		"Bool",		""
":TT", "Unsigned8", 		"Ubyte",	""
":TT", "Unsigned16", 		"Ushort",	""
":TT", "Integer32", 		"Long",		""
":TT", "TimeInterval16", 	"<Integer16>",	""

